NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:5432/atlas
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_characters_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_characters_long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
COOKIE_DOMAIN=localhost

# Email (Mailpit en dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Atlas <no-reply@atlasgym.cl>"
SMTP_SECURE=false

# Webpay (Transbank) — usar credenciales de ambiente integration
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_ENV=integration

# Storage (Cloudflare R2 / S3-compatible)
S3_ENDPOINT=
S3_BUCKET=atlas-uploads
S3_ACCESS_KEY=
S3_SECRET=
S3_REGION=auto

# Web Push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:contacto@atlasgym.cl
