# =====================================================
# Atlas — variables de entorno raíz (referencia general)
# =====================================================
# Cada app tiene su propio .env. Este archivo es referencia.
# Copia a .env y completa los valores.

# --- API (apps/api/.env) ---
# DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:5432/atlas
# REDIS_URL=redis://localhost:6379
# JWT_ACCESS_SECRET=change_me_in_production_min_32_chars
# JWT_REFRESH_SECRET=change_me_in_production_min_32_chars_different
# COOKIE_DOMAIN=localhost
# NODE_ENV=development
# PORT=4000
# PUBLIC_BASE_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173

# Webpay (Transbank)
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# WEBPAY_ENV=integration

# Email (Resend en prod, Mailpit en dev)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM="Atlas <no-reply@atlasgym.cl>"
# RESEND_API_KEY=

# S3 / R2
# S3_ENDPOINT=
# S3_BUCKET=atlas-uploads
# S3_ACCESS_KEY=
# S3_SECRET=
# S3_REGION=auto

# Web Push
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# VAPID_SUBJECT=mailto:contacto@atlasgym.cl

# --- WEB (apps/web/.env) ---
# VITE_API_URL=http://localhost:4000
# VITE_VAPID_PUBLIC=
